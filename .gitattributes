# HomeHub .gitattributes
# Git stores every text file with LF line endings and checks it out with LF
# on every machine, Windows included (GIT-7). This file travels with the
# repo, so it overrides each machine's core.autocrlf setting.
* text=auto eol=lf

# Windows batch files only run reliably with CRLF line endings.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never convert line endings or diff them as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff2 binary
