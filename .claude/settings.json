{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "PowerShell(npm run *)",
      "Bash(npm start *)",
      "PowerShell(npm start *)",
      "Bash(git status *)",
      "PowerShell(git status *)",
      "Bash(git log *)",
      "PowerShell(git log *)",
      "Bash(git show *)",
      "PowerShell(git show *)",
      "Bash(git ls-files *)",
      "PowerShell(git ls-files *)",
      "Bash(git rev-parse *)",
      "PowerShell(git rev-parse *)",
      "Bash(git branch --show-current)",
      "PowerShell(git branch --show-current)",
      "Bash(git remote -v)",
      "PowerShell(git remote -v)"
    ],
    "ask": [
      "Bash(git *--output*)",
      "PowerShell(git *--output*)",
      "Bash(git *--no-index*)",
      "PowerShell(git *--no-index*)",
      "Bash(git *.env*)",
      "PowerShell(git *.env*)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(docker *)",
      "PowerShell(docker *)",
      "Bash(npm install *)",
      "PowerShell(npm install *)",
      "Bash(npm i *)",
      "PowerShell(npm i *)",
      "Bash(npm ci *)",
      "PowerShell(npm ci *)",
      "Bash(npm add *)",
      "PowerShell(npm add *)",
      "Bash(npm uninstall *)",
      "PowerShell(npm uninstall *)",
      "Bash(npm update *)",
      "PowerShell(npm update *)",
      "Bash(npx *)",
      "PowerShell(npx *)",
      "Bash(npm exec *)",
      "PowerShell(npm exec *)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(/data/**)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Select-String *.env*)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(gh pr * merge *)",
      "PowerShell(gh pr * merge *)"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable"
  }
}
